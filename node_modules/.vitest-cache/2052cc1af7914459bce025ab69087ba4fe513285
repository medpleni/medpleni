	const headerTitle = isExamSpecific ? `📋 *MEDPLENI · RESUMO DA AVALIAÇÃO PARA A COORDENAÇÃO*` : `📋 *MEDPLENI · RESUMO SEMANAL DE ACOMPANHAMENTO*`;
	const contextLine = isExamSpecific ? `Avaliação: ${examTitle} · ${institutionName}` : `Instituição: ${institutionName} · Período: ${periodLabel}`;
	let text = `${headerTitle}\n${contextLine}\n\n`;
