	const individualAttentionList = attentionList.map((st) => {
		const remainingReasons = st.reasons.filter((r) => !aggregatedKeys.has(`${st.classGroupId}__${r.key}`));
		return {
			...st,
			reasons: remainingReasons
		};
	}).filter((st) => st.reasons.length > 0);
	return {
		classAlerts,
		individualAttentionList
	};
};
