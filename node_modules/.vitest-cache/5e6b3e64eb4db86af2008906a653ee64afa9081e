		let isRecovered = false;
		if (plan.verifiedScore !== undefined && plan.verifiedScore !== null) {
			gain = Math.round((plan.verifiedScore - plan.initialScore) * 10) / 10;
			isRecovered = plan.verifiedScore >= 60;
		};
