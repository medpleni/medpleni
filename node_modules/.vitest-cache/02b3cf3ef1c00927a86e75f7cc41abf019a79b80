	const criticalGaps = [];
	const INEP_AREAS = [
		"Clínica Médica",
		"Cirurgia Geral",
		"Pediatria",
		"Ginecologia e Obstetrícia",
		"Medicina de Família e Comunidade",
		"Saúde Coletiva",
		"Saúde Mental"
	];
	for (const cg of scopedClassGroups) {
		const cgAttempts = attempts.filter((a) => a.classGroupId === cg.id);
		const baseScore = cgAttempts.length > 0 ? cgAttempts.reduce((s, a) => s + (a.scorePercentage || 0), 0) / cgAttempts.length : 52;
		for (const area of INEP_AREAS) {
