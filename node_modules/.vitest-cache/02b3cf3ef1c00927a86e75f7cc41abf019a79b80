*/
function calculateDocenteDashboard(params) {
	const { scopedClassGroups, attempts, items, assessments, teacherUserId, pendingQuestionsReviewCount = 0, cutScore = 60 } = params;
	// Bloco 1: Minhas turmas com média da última prova e alunos abaixo de 60
	const classes = scopedClassGroups.map((cg) => {
