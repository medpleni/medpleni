* 2. CURVA DE DISTRIBUIÇÃO DAS NOTAS EM FAIXAS DE 5 PONTOS
* ─────────────────────────────────────────────────────────────────────────────
*/
function calculateScoreDistribution(presentScores, cutScore = 60, medianScore = 60) {
	const buckets = [];
