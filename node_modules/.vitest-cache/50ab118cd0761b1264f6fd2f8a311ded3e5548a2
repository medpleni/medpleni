};
function calculateAllAxesPerformance(items, overallExamAverage) {
	// Filtra apenas itens válidos (anulados saem das estatísticas)
	const validItems = items.filter((it) => it.status === "valido");
	const results = [];
	const axesConfig = [
		{
			type: "area",
			label: "Grande Área",
			extractor: (it) => it.area
		},
		{
			type: "cenario",
			label: "Cenário de Atuação",
			extractor: (it) => it.cenario
		},
		{
			type: "tema",
			label: "Tema Clínico",
			extractor: (it) => it.tema
		},
		{
			type: "competencia",
			label: "Competência",
			extractor: (it) => it.competencia
		}
	];
	axesConfig.forEach((cfg) => {
		const categoryMap = new Map();
		validItems.forEach((it) => {
			const val = cfg.extractor(it)?.trim();
			if (!val) return;
			const current = categoryMap.get(val) || {
				totalQuestions: 0,
				studentCorrectCount: 0,
				studentTotalAttempts: 0
			};
			current.totalQuestions += 1;
			it.answers.forEach((ans) => {
				current.studentTotalAttempts += 1;
				if (ans.isCorrect) {
					current.studentCorrectCount += 1;
				}
			});
			categoryMap.set(val, current);
		});
		// Se a prova possui questões categorizadas neste eixo, inclui a aba
		if (categoryMap.size > 0) {
			const itemsList = Array.from(categoryMap.entries()).map(([name, stat]) => {
				const avg = stat.studentTotalAttempts > 0 ? Number((stat.studentCorrectCount / stat.studentTotalAttempts * 100).toFixed(1)) : 0;
				const isLow = stat.totalQuestions < 5;
				return {
					id: name,
					name,
					totalValidQuestions: stat.totalQuestions,
					averageScorePercentage: avg,
					hasLowQuestionCountWarning: isLow,
					warningText: isLow ? "Amostra pequena (< 5 questões): sujeito a oscilação estatística" : undefined
				};
			});
			// Ordena por nome
			itemsList.sort((a, b) => a.name.localeCompare(b.name));
			results.push({
				axisType: cfg.type,
				axisLabel: cfg.label,
				items: itemsList,
				overallExamAverage
			});
		}
	});
	return results;
};
/**
* ─────────────────────────────────────────────────────────────────────────────
* 4. TABELA TURMAS × RESULTADO
