		const max = min + 5;
		const isLast = i === 19;
		const count = presentScores.filter((s) => {
			if (isLast) {
				return s >= min && s <= max;
			};
			return s >= min && s < max;
		}).length;
		const percentage = total > 0 ? Number((count / total * 100).toFixed(1)) : 0;
		const isCutScoreBucket = min <= cutScore && cutScore <= max;
		const isMedianBucket = min <= medianScore && medianScore <= max;
		buckets.push({
			index: i + 1,
			rangeLabel: `${min}–${max}%`,
			min,
			max,
