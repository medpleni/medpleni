			previousScoreDelta = Number((st.scorePercentage - st.previousScorePercentage).toFixed(1));
			notice = previousExamTitle ? `Variação nominal calculada em relação a "${previousExamTitle}". Atenção: provas diferentes possuem graus de dificuldade distintos e não utilizam a mesma régua métrica.` : "Atenção: provas diferentes possuem graus de dificuldade distintos e não utilizam a mesma régua métrica.";
		} else {
			notice = "Primeira avaliação deste tipo realizada pelo aluno no sistema.";
		};
		return {
			studentUserId: st.studentUserId,
			studentName: st.studentName,
			studentRa: st.studentRa,
			classGroupId: st.classGroupId,
			classGroupName: st.classGroupName,
