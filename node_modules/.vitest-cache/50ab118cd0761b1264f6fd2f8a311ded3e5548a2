function getPerformanceBand(scorePercentage) {
	if (scorePercentage < 51) {
		return {
			band: "ate_50",
			label: "Até 50% (Crítico)",
			color: "text-rose-700 bg-rose-50 border-rose-200 dark:bg-rose-950/40 dark:text-rose-400"
		};
	};
	if (scorePercentage <= 60) {
		return {
			band: "faixa_51_60",
			label: "51–60% (Zona de Decisão)",
			color: "text-amber-700 bg-amber-50 border-amber-200 dark:bg-amber-950/40 dark:text-amber-400"
		};
	};
	if (scorePercentage <= 70) {
		return {
			band: "faixa_61_70",
			label: "61–70% (Proficiente)",
			color: "text-blue-700 bg-blue-50 border-blue-200 dark:bg-blue-950/40 dark:text-blue-400"
		};
	};
	return {
		band: "faixa_71_mais",
		label: "71%+ (Excelente)",
		color: "text-emerald-700 bg-emerald-50 border-emerald-200 dark:bg-emerald-950/40 dark:text-emerald-400"
	};
};
function buildStudentResultRows(params) {
	const { students, previousExamTitle } = params;
	return students.map((st) => {
		const bandInfo = getPerformanceBand(st.scorePercentage);
		let previousScoreDelta = null;
		let notice = "";
