function calculateExamSummaryStats(params) {
	const { presentScores, totalEnrolled, totalAbsent, cutScore = 60, academicTermLabel = "2027.1", assessmentTitle = "Caderno Oficial" } = params;
	const totalPresent = presentScores.length;
	if (totalPresent === 0) {
		return {
			totalEnrolled,
			totalPresent: 0,
			totalAbsent,
			meanScore: 0,
			medianScore: 0,
			p25: 0,
			p75: 0,
			belowCutScoreCount: 0,
			belowCutScorePercentage: 0,
			cutScore,
			minScore: 0,
			maxScore: 0,
			footer: {
				base: `Alunos presentes: 0 de ${totalEnrolled} convocados`,
				period: academicTermLabel,
				source: `MedPleni Avaliações • ${assessmentTitle}`
			}
		};
	};
	// Ordena para cálculo de percentis
	const sorted = [...presentScores].sort((a, b) => a - b);
	const sum = sorted.reduce((acc, val) => acc + val, 0);
	const meanScore = Number((sum / totalPresent).toFixed(2));
	const medianScore = calculatePercentile(sorted, .5);
	const p25 = calculatePercentile(sorted, .25);
	const p75 = calculatePercentile(sorted, .75);
	const minScore = sorted[0];
	const maxScore = sorted[sorted.length - 1];
	const belowCutScoreCount = sorted.filter((score) => score < cutScore).length;
	const belowCutScorePercentage = Number((belowCutScoreCount / totalPresent * 100).toFixed(2));
	return {
		totalEnrolled,
		totalPresent,
		totalAbsent,
		meanScore,
		medianScore,
		p25,
		p75,
		belowCutScoreCount,
		belowCutScorePercentage,
		cutScore,
		minScore,
		maxScore,
		footer: {
			base: `Base: ${totalPresent} alunos presentes (${totalAbsent} ausentes)`,
			period: `Período: ${academicTermLabel}`,
			source: `Fonte: MedPleni Avaliações • ${assessmentTitle}`
		}
	};
};
/**
